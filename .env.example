# Model (router + ajanlar) — zorunlu
XAI_API_KEY=

# Embedding (tarif RAG). Yoksa anahtar-kelime tabanlı yedek retriever devreye girer.
OPENAI_API_KEY=

# Web arama. Yoksa Tavily aracı "arama kapalı" cevabı döner, grafik çalışmaya devam eder.
TAVILY_API_KEY=

# İzleme (LangSmith)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=mutfak-asistani

# Yalnızca yerel Mac'te (kurumsal TLS denetimi): sistem sertifikalarını kullan
# MUTFAK_TRUSTSTORE=1

# Yalnızca yerel test: istemci user_id değerini Store namespace için kabul et (üretimde AÇMAYIN)
# MUTFAK_TRUST_USER_ID=1
